MyTelegramVersion=latest
MyTelegramRegistry=mytelegram
DefaultConnectionStrings=mongodb://mongodb:27017
DefaultLogLevel=Information
Serilog__MinimumLevel__Default=Information

# API ключи (должны СТРОГО совпадать с теми, что в APK)
App__AppId=26241381
App__ApiHash=fe1046e04b4a0196b0e5efcbc4d62093

App__DatabaseName=mytelegram
App__ReadModelDatabaseName=mytelegram_readmodel
App__BotDatabaseName=mytelegram_bot
App__CreateTestUsers=true
App__AccessHashSecretKey=super_secret_key_123
App__FixedVerifyCode=22222
App__VerificationCodeLength=5
App__VerificationCodeExpirationSeconds=300
App__CheckPhoneNumberFormat=false
App__EnableSearchNonContacts=true

# Настройки твоего Дата-центра (DC)
App__DcOptions__0__Id=1
App__DcOptions__0__IpAddress=45.150.34.220
App__DcOptions__0__Port=20443

# Порты серверов
App__Servers__0__Port=20443
App__Servers__1__Port=20543
App__Servers__2__Port=20643
App__Servers__3__Port=20743

# Базы данных (внутренние имена Docker)
Redis__Configuration=redis:6379
ConnectionStrings__Default=mongodb://mongodb:27017

# RabbitMQ конфиг
RabbitMQ__Connections__Default__HostName=rabbitmq
RabbitMQ__Connections__Default__Port=5672
RabbitMQ__Connections__Default__UserName=test
RabbitMQ__Connections__Default__Password=test
RabbitMQ__EventBus__ExchangeName=mytelegram_event_bus

# Хранилище (Медиа)
Minio__Endpoint=http://minio:9000
Minio__AccessKey=admin
Minio__SecretKey=password
